{
  "format": 1,
  "name": "Scene report",
  "enabled": false,
  "order": 2,
  "trigger": {
    "kind": "afterReply",
    "share": 0.5
  },
  "sheet": {
    "nodes": [
      {
        "id": "prompt",
        "type": "chat.prompt",
        "x": 320,
        "y": 0
      },
      {
        "id": "persona",
        "type": "chat.persona",
        "x": 320,
        "y": 128
      },
      {
        "id": "character",
        "type": "chat.character",
        "x": 320,
        "y": 320
      },
      {
        "id": "world",
        "type": "chat.world",
        "x": 320,
        "y": 544
      },
      {
        "id": "messages",
        "type": "chat.messages",
        "x": 320,
        "y": 768,
        "values": {
          "Last": 3,
          "Raw": true
        }
      },
      {
        "id": "previous",
        "type": "chat.record",
        "x": 0,
        "y": 832,
        "values": {
          "Tag": "scene"
        }
      },
      {
        "id": "ask",
        "type": "graph.text",
        "x": 0,
        "y": 1024,
        "values": {
          "Value": "Pause the roleplay and ignore the roleplay formatting instructions above. Write in the same language as the latest messages above. State the current scene in four short factual lines in this exact order — Location:, Clothing:, Pose:, Mood: in English, or Место:, Одежда:, Поза:, Настроение: in Russian (translate the four labels if the chat uses another language) — based strictly on the latest messages, updating the previous report only where those messages changed it, or establishing it when there is none. Use {{char}}'s card only for baseline attire of the active outfit when unspecified in the messages, ignoring example dialogues and general habits. Include {{char}} (and {{user}} where the scene specifies their attire or position) in Clothing and Pose; Mood describes {{char}} only. Output only the four lines, with no bullets, bold, asterisks, quotes or extra text."
        }
      },
      {
        "id": "join",
        "type": "graph.join",
        "x": 320,
        "y": 1024,
        "values": {
          "Template": "Previous scene report:\n{0}\n\nInstruction:\n{1}"
        }
      },
      {
        "id": "collector",
        "type": "chat.collector",
        "x": 640,
        "y": 384
      },
      {
        "id": "model",
        "type": "chat.model-call",
        "x": 960,
        "y": 384,
        "values": {
          "Samplers": "precise-d4000003",
          "Thinking": "Off",
          "OverrideReplyLength": true,
          "ReplyLength": 256,
          "OverrideTemperature": true,
          "Temperature": 0.65
        }
      },
      {
        "id": "insert",
        "type": "chat.insert",
        "x": 1280,
        "y": 384,
        "values": {
          "Role": "System",
          "Tag": "scene",
          "Template": "[Current scene:\n{0}]"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "fromNode": "prompt",
        "fromPin": "Prompt",
        "toNode": "collector",
        "toPin": "Prompt"
      },
      {
